# Copy these variable names to your current shell or a private ignored profile.
# Do not commit real runtime values.

# Required for submit-script generation. Keep the literal {vasp_bin} marker.
export VIBEDFT_VASP_CMD="<VASP_LAUNCH_COMMAND_WITH_{vasp_bin}>"

# Required for POTCAR generation fallback.
export VIBEDFT_POTCAR_DIR="<POTCAR_LIBRARY_PATH>"

