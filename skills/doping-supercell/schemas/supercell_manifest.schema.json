{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doping-supercell:supercell-manifest:v1",
  "title": "Pristine Supercell Manifest",
  "type": "object",
  "required": [
    "schema",
    "artifact_type",
    "status",
    "stage",
    "mode",
    "parent",
    "generation",
    "pristine_supercell",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "doping-supercell.supercell-manifest/v1"
    },
    "artifact_type": {
      "const": "pristine_supercell"
    },
    "status": {
      "const": "passed"
    },
    "stage": {
      "const": "build-supercell"
    },
    "mode": {
      "enum": [
        "auto",
        "explicit"
      ]
    },
    "parent": {
      "$ref": "#/$defs/artifact"
    },
    "generation": {
      "type": "object",
      "required": [
        "mode",
        "requested",
        "supercell_matrix",
        "supercell_det",
        "minimum_image_distance_A",
        "parent_preserved",
        "fractional_mapping"
      ],
      "properties": {
        "supercell_matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          }
        },
        "parent_preserved": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "pristine_supercell": {
      "$ref": "#/$defs/artifact"
    },
    "validation": {
      "type": "object",
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "atoms",
        "formula"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "atoms": {
          "type": "integer",
          "minimum": 1
        },
        "formula": {
          "type": "object"
        },
        "species_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
